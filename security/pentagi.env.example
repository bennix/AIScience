# Configuration reference only. This is not a deployed PentAGI instance.
# Follow the checked-out upstream installation guide and test both providers.
# Put real secrets only into a private .env (mode 600), never this file or chat.
PUBLIC_URL=https://localhost:8443
CORS_ORIGINS=https://localhost:8443
PENTAGI_LISTEN_IP=127.0.0.1
PENTAGI_LISTEN_PORT=8443
LLM_SERVER_URL=https://zenmux.ai/api/v1
LLM_SERVER_MODEL=anthropic/claude-sonnet-5.5
LLM_SERVER_KEY=
# Alternative chat model: google/gemini-4-argon
EMBEDDING_PROVIDER=openai
EMBEDDING_URL=https://zenmux.ai/api/v1
EMBEDDING_MODEL=openai/text-embedding-3-large
EMBEDDING_KEY=
# Alternative embedding model: google/gemini-embedding-2
# Require OpenAI-compatible /embeddings support and etester before use.
# Generate unique values before deployment:
COOKIE_SIGNING_SALT=
PENTAGI_POSTGRES_PASSWORD=
