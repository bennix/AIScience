{
  "name": "science-workbench",
  "version": "0.3.0",
  "private": true,
  "description": "Evidence-led AI research workbench powered by ZenMux",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "node --check electron/main.cjs && node --check electron/core.cjs && node --check electron/math-typeset.cjs && node --check electron/environment.cjs && node --check electron/rag.cjs && node --check electron/attachments.cjs && node --check electron/office.cjs && node --check electron/code-reference.cjs && node --check electron/languages.cjs && node --check electron/math-verification.cjs && node --check electron/formal-proof.cjs && node --check electron/preload.cjs && node --check src/markdown.js && node --check src/app.js",
    "package": "electron-packager . 'Science Workbench' --platform=darwin --arch=arm64 --out=dist --overwrite --ignore='^/(work|tests|dist)($|/)'",
    "test:e2e": "node tests/electron.e2e.cjs",
    "test:environment": "node tests/environment.integration.cjs",
    "test:attachments": "node tests/attachments-reference.e2e.cjs",
    "test:math-gate": "node tests/math-gate.e2e.cjs",
    "test:formal": "node tests/formal-proof.e2e.cjs",
    "dist:mac": "NOTARIZE_APP=1 electron-builder --mac --arm64 --publish never",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:linux": "electron-builder --linux --x64 --publish never",
    "notarize": "node scripts/notarize-dmg.cjs",
    "test:data-literature": "node tests/data-literature.e2e.cjs",
    "test:site": "node tests/site.e2e.cjs",
    "test:stream-math": "node tests/stream-math.e2e.cjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^42.0.0",
    "electron-builder": "26.15.3",
    "playwright": "^1.64.1"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "dompurify": "^3.3.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "katex": "^0.19.0",
    "marked": "^17.0.0",
    "pdf-parse": "^2.4.5"
  },
  "author": "bennix",
  "homepage": "https://bennix.github.io/AIScience/",
  "repository": {
    "type": "git",
    "url": "https://github.com/bennix/AIScience.git"
  },
  "license": "UNLICENSED"
}
